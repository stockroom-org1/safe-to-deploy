{
  "name": "safe-to-deploy",
  "version": "0.1.0",
  "description": "Github Action to evaluate - Is it safe to deploy today? — a single, policy-grounded answer at every deployment gate, with an immutable audit trail.",
  "main": "index.ts",
  "scripts": {
    "build": "tsc",
    "pack": "ncc build src/index.ts -o dist",
    "debug": "node --inspect-brk=9229 --enable-source-maps node_modules/tsx/dist/cli.mjs src/index.ts"
  },
  "dependencies": {
    "@actions/core": "^2.0.1",
    "@actions/github": "^8.0.0",
    "@octokit/rest": "^20.0.2",
    "sjcl": "^1.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/sjcl": "^1.0.34",
    "@vercel/ncc": "^0.38.1",
    "ts-loader": "^9.6.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2"
  }
}
